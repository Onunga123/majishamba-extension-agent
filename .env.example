# Kachieng AI Agent — environment configuration template
# Copy this file to .env and adjust as needed.
# Do NOT commit .env to version control.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
MAJISHAMBA_DEBUG=True
MAJISHAMBA_SECRET_KEY=change-me-in-production

# --- Map / basemap ---
# DEFAULT: Stadia Maps Alidade Smooth — free for localhost/127.0.0.1 development.
# No API key needed for local dev. The browser sends Referer: http://localhost:8000
# which Stadia Maps recognizes and serves tiles without authentication.
#
# For production:
#   1. Register at https://stadiamaps.com/ (free tier available)
#   2. Set KACHIENG_MAP_API_KEY to your key
#   3. Add your production domain to the Stadia Maps dashboard
#
# To use a different provider entirely, set KACHIENG_MAP_TILES to the tile URL template:
#   KACHIENG_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png  (strict usage policy)
#   KACHIENG_MAP_TILES=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}.png
#   KACHIENG_MAP_TILES=https://tiles.stadiamaps.com/tiles/outdoors/{z}/{x}/{y}.png
#
# KACHIENG_MAP_TILES=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}.png
# KACHIENG_MAP_API_KEY=
# KACHIENG_MAP_ATTRIBUTION=© Stadia Maps © OpenMapTiles © OpenStreetMap contributors

# --- LLM provider ---
# Default: none (falls back to deterministic template — officer reviews a structured evidence summary)
# For OpenRouter (recommended — works on any laptop, no local model needed):
#   1. Create a free account at https://openrouter.ai
#   2. Create an API key at https://openrouter.ai/keys
#   3. Set LLM_PROVIDER=openrouter and OPENROUTER_API_KEY=sk-or-v1-... below
#   Default model: google/gemma-4-31b-it:free (free, 262K context, good at JSON)
#   Alternative: qwen/qwen3.7-flash (very cheap: $0.00000003/token)
# For Ollama (optional — for judges/local use, needs Ollama installed):
#   Set LLM_PROVIDER=ollama, OLLAMA_HOST=http://127.0.0.1:11434, OLLAMA_MODEL=qwen2.5:7b-instruct
#
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_TIMEOUT_SECONDS=60
# OPENROUTER_MAX_OUTPUT_TOKENS=800

# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# MAJISHAMBA_SKIP_OLLAMA=0
# MAJISHAMBA_OLLAMA_TIMEOUT=10

# --- Demo mode ---
DEMO_MODE=1
