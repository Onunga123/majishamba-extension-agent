# Kachieng AI Agent — environment configuration template
# Copy this file to .env and adjust as needed.
# Do NOT commit .env to version control.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
MAJISHAMBA_DEBUG=True
MAJISHAMBA_SECRET_KEY=change-me-in-production
# Space/comma-separated public origins allowed to submit POST requests.
# Include the scheme, e.g. https://app.example.com (not just the hostname).
# MAJISHAMBA_CSRF_TRUSTED_ORIGINS=https://app.example.com

# --- Map / basemap ---
# MapLibre uses CARTO Voyager raster tiles. The key is visible in browser
# requests (it is not a backend secret); restrict it to local/deployed
# referrers in the CARTO dashboard where supported.
CARTO_BASEMAP_API_KEY=your_carto_basemap_api_key_here
# Optional override for a deliberately supported alternative provider:
# KACHIENG_MAP_TILES=https://example.invalid/{z}/{x}/{y}.png
# KACHIENG_MAP_ATTRIBUTION=© OpenStreetMap contributors

# --- LLM provider ---
# Recommended demo mode: OpenRouter cloud inference (works without local model hardware).
#   1. Create a free account at https://openrouter.ai
#   2. Create an API key at https://openrouter.ai/keys
#   3. Copy this file to .env and replace the placeholder below locally.
#
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_MAX_OUTPUT_TOKENS=1500

# Alternative local mode (does not require an OpenRouter key):
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct

# Explicit deterministic mode (no model/API call):
# LLM_PROVIDER=none

# --- Demo mode ---
DEMO_MODE=1
